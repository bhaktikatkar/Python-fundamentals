# Practice


# 1. Print numbers from 1 to 10 using a for loop.

for i in range(1, 11):
    print(i)

#==========================================================================
# 2. Print even numbers from 1 to 20.

for i in range(1, 21):
    if i % 2 == 0:
        print(i)

#============================================================================
# 3. Print odd numbers from 1 to 20.

for i in range(1, 21):
    if i % 2 != 0:
        print(i)

#============================================================================
# 4. Calculate the sum of numbers from 1 to 10.

total = 0

for i in range(1, 11):
    total += i

print("Sum:", total)

#==================================================================================
# 5. Print the multiplication table of a number.

number = 7

for i in range(1, 11):
    print(number, "x", i, "=", number * i)

#==================================================================================
# 6. Count the number of vowels in a string.

text = "Python Programming"

count = 0

for character in text:
    if character in "aeiouAEIOU":
        count += 1

print("Number of vowels:", count)

#====================================================================================
# 7. Find the largest number in a list.

numbers = [12, 45, 23, 67, 34, 89, 10]

largest = numbers[0]

for number in numbers:
    if number > largest:
        largest = number

print("Largest number:", largest)

#======================================================================================
# 8. Use a while loop to print numbers from 1 to 10.

number = 1

while number <= 10:
    print(number)
    number += 1

#=====================================================================================
# 9. Use break to stop a loop when the number reaches 6.

for i in range(1, 11):
    if i == 6:
        break
    print(i)

#==========================================================================================
# 10. Use continue to skip the number 5.

for i in range(1, 11):
    if i == 5:
        continue
    print(i)

#==========================================================================================
# 11. Calculate the factorial of a number.

number = 5
factorial = 1

for i in range(1, number + 1):
    factorial *= i

print("Factorial:", factorial)


